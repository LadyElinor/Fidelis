{
  "name": "@fidelis/sophron-cer",
  "version": "2.0.0",
  "private": true,
  "description": "SOPHRON-CER receipt-validation and evidence-spine prototype; current script surface still mixes validator and research-pipeline examples",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "lint": "eslint .",
    "examples:analyze": "node src/cli.js analyze",
    "validate": "node src/cli.js validate",
    "report": "node src/cli.js report",
    "examples:quickstart": "node examples/minimal_pipeline/run_minimal_pipeline.js",
    "examples:cer-pipeline": "node examples/cer_pipeline/run_cer_pipeline.js",
    "examples:regime-pipeline": "node examples/regime_frontier_pipeline/run_regime_frontier_pipeline.js",
    "examples:physics-pipeline": "node examples/physics_pipeline/run_physics_pipeline.js",
    "examples:hodge-nl-pipeline": "node examples/hodge_nl_pipeline/run_hodge_nl_pipeline.js",
    "examples:strategy-rank": "node examples/strategy_prioritization/run_strategy_ranking.js",
    "examples:alignment-eval": "node examples/alignment_eval/run_alignment_eval.js",
    "examples:alignment-calibrate": "node examples/alignment_eval_calibration/run_alignment_calibration.js",
    "examples:alignment-policy-patch": "node examples/alignment_eval_calibration/run_generate_policy_patch.js",
    "examples:note": "node -e \"console.log('Research/example scripts below this line are not a claim of clean final package scope.')\""
  },
  "keywords": [
    "telemetry",
    "observability",
    "safety",
    "content-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4",
    "pino": "^8.16.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "csv-writer": "^1.6.0",
    "csv-parse": "^5.5.2",
    "simple-statistics": "^7.8.3"
  },
  "devDependencies": {
    "eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
